# Copia este archivo a .env y edítalo. NUNCA subas .env al repositorio.
# En local puedes dejarlo casi tal cual: el sitio corre sin correo ni avisos.

ALLOWED_ORIGIN=http://127.0.0.1:8000
DB_PATH=leads.db

# ---------------------------------------------------------------------------
# AVISOS DE LEADS — cómo enterarte sin montar correo
# ---------------------------------------------------------------------------
# NOTIFY_CHANNEL: none | telegram | slack | discord
# Recomendado mientras no haya correo del dominio: telegram. No necesita DNS,
# ni remitente verificado; el lead llega al teléfono en segundos.
NOTIFY_CHANNEL=none

# Telegram: escribe a @BotFather, /newbot, y te da el token.
# Chat id: manda un mensaje a tu bot y abre
#   https://api.telegram.org/bot<TU_TOKEN>/getUpdates
# El número en "chat":{"id":...} es TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack o Discord: pega la URL del webhook entrante del canal.
WEBHOOK_URL=

# ---------------------------------------------------------------------------
# CORREO (opcional) — requiere remitente verificado, normalmente con dominio
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# Token para GET /api/leads. Sin token el endpoint queda cerrado.
# Genera uno: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=3600
